# Dev-only Caddyfile for the MANUALS containerized stack (single-origin).
#
# Mirrors the production routing (ADR 0061): the admin-panel SPA at "/" and the
# api-server under "/api/*" on ONE origin. Production terminates TLS on 443; here
# we serve plain HTTP on :8080 so the manuals can screenshot the reverse proxy
# without a self-signed-cert browser warning. The app is built with
# NEXT_PUBLIC_API_URL=/api so every REST/WS call is same-origin through Caddy.
{
	admin off
	auto_https off
}

:8080 {
	# Caddy's own liveness (plain 200, no proxy) for the compose healthcheck.
	handle /healthz {
		respond "ok" 200
	}

	# /api/* → api-server. handle_path STRIPS the /api prefix so the api-server
	# sees its real routes (/auth/login, /projects, …) exactly as in dev.
	#
	# health_uri /readyz (task_audit14_08): Caddy deja de mandar tráfico a la
	# api-server cuando ésta no puede atenderlo (PostgreSQL o Redis caídos) y lo
	# repone solo en cuanto vuelve a 200. NO se toca el `healthcheck` del
	# contenedor, que es liveness (/healthz): el watchdog reinicia lo unhealthy,
	# así que apuntarlo a readiness pondría la api-server en bucle de reinicios
	# cada vez que se cayera una dependencia.
	handle_path /api/* {
		reverse_proxy api-server:8000 {
			health_uri /readyz
			health_interval 10s
			health_timeout 5s
			health_status 2xx
		}
	}

	# Everything else → the Next.js admin-panel SPA.
	reverse_proxy admin-panel:3000

	encode gzip
}
