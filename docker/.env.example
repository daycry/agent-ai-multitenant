# Copy this file to .env and adjust before running `docker compose up`.
#
#     cp docker/.env.example docker/.env
#
# OBLIGATORIO desde prod-10 (task_prod10_05/06, hallazgos secrets-6/7). El
# compose canónico ya NO cae en contraseñas por defecto: cada credencial se
# declara `${VAR:?…}`, así que un despliegue al que le falte una **no arranca**
# en vez de arrancar con una contraseña escrita en este repositorio público.
# `docker compose` carga automáticamente el `.env` del directorio del primer
# fichero `-f` (aquí, `docker/`).
#
# Ojo con una trampa de Compose: `${VAR:?…}` se resuelve al CARGAR cada fichero,
# ANTES del merge de overlays. Un `docker-compose.dev.yml` con `${VAR:-default}`
# NO rescata al base — por eso los valores de dev viven aquí y no en el overlay.
#
# `.env` está en .gitignore. Las credenciales de producción las inyecta el
# instalador desde Vault; los valores de abajo son SOLO para desarrollo local y
# son públicos por definición (están en este fichero de ejemplo).
#
# Variables OBLIGATORIAS (sin default en el compose):
#   POSTGRES_PASSWORD, MIGRATIONS_USER_PASSWORD, APP_USER_PASSWORD,
#   REDIS_PASSWORD, MINIO_ROOT_PASSWORD, SEARXNG_SECRET
#   y, con el overlay de monitoring, GRAFANA_ADMIN_PASSWORD.
# La tabla completa está en docs/04-reference/mandatory-env-vars.md.

# ----------------------------------------------------------------------
# PostgreSQL
# ----------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme-dev-only
POSTGRES_DB=agentic_platform
# 15432 by default to avoid clashes with locally-installed postgres
# (e.g. Laragon on Windows). Set to 5432 if your host has none.
POSTGRES_PORT=15432

# Roles created by docker/postgres/init/02-roles.sh on first start.
# migrations_user runs Alembic (DDL). app_user runs the services (DML).
MIGRATIONS_USER_PASSWORD=changeme-migrations-dev-only
APP_USER_PASSWORD=changeme-app-dev-only

# ----------------------------------------------------------------------
# Redis
# ----------------------------------------------------------------------
REDIS_MAX_MEM=512mb
REDIS_PORT=6379
# OBLIGATORIA (prod-10 / secrets-7). Redis aloja las SESIONES de servidor y el
# broker de Celery: sin `requirepass`, cualquiera con acceso al puerto lee
# sesiones y encola trabajo para los workers. Los clientes la llevan en la URL:
#   redis://:<REDIS_PASSWORD>@redis:6379/<db>
# Para hablar con el Redis del stack desde el host (tests de integración,
# redis-cli), la URL es redis://:<REDIS_PASSWORD>@localhost:6379/<db>.
REDIS_PASSWORD=changeme-redis-dev-only

# ----------------------------------------------------------------------
# MinIO
# ----------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme-dev-only
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ----------------------------------------------------------------------
# Vault
# ----------------------------------------------------------------------
# In dev mode (docker-compose.dev.yml), Vault starts auto-unsealed
# with this token. In production (docker-compose.yml alone), Vault
# starts sealed and scripts/init-vault.sh generates Shamir keys.
VAULT_DEV_ROOT_TOKEN=dev-root-token
VAULT_PORT=8200

# ----------------------------------------------------------------------
# ClamAV
# ----------------------------------------------------------------------
CLAMAV_PORT=3310

# ----------------------------------------------------------------------
# egress-proxy (ADR 0019 / task_02_35) — tinyproxy allowlisted.
# Sólo se expone al host en dev para que el dashboard health-check del
# api-server (corriendo fuera de docker) pueda alcanzarlo.
# ----------------------------------------------------------------------
EGRESS_PROXY_PORT=8888

# ----------------------------------------------------------------------
# docling-serve (Plan 04 Fase C) — open-source document parser.
# La imagen está pineada en docker-compose.yml a
# ghcr.io/docling-project/docling-serve:v1.20.0 (NO :latest) por
# reproducibilidad y supply-chain (container-isolation-4). Para subir de
# versión, edita el tag tras verificar el contrato /v1/convert.
# ----------------------------------------------------------------------
DOCLING_SERVE_PORT=5001

# ----------------------------------------------------------------------
# docling-mcp (Plan 04 Fase E) — MCP-protocol surface of Docling.
# NO se levanta en dev: upstream no publica imagen pública en GHCR.
# Ver docs/03-guides/gotchas/docling-mcp-no-public-image.md. La variable
# queda aquí por si se reactiva en el futuro.
# ----------------------------------------------------------------------
# DOCLING_MCP_PORT=3000

# ----------------------------------------------------------------------
# Ollama (Plan 04 task_04_14 / ADR 0056) — in-stack local embeddings.
# The `ollama` service runs on CPU by default; `ollama-bootstrap` pulls
# EMBEDDING_MODEL into the volume once on first `up`. For GPU (CUDA) add
# docker/docker-compose.gpu.yml (needs the NVIDIA Container Toolkit).
# EMBEDDING_MODEL is the REAL Ollama registry name (768 dims) — NOT the
# `-v1.5` suffix, which is not a valid tag. Keep it in lockstep with the
# api-server's API_SERVER_EMBEDDING_MODEL.
# ----------------------------------------------------------------------
OLLAMA_PORT=11434
EMBEDDING_MODEL=nomic-embed-text
IMAGE_OLLAMA=ollama/ollama:0.31.1

# ----------------------------------------------------------------------
# Monitoring overlay (Plan 12 Fase D — docker-compose.monitoring.yml).
# Prometheus + node-exporter + cAdvisor. Images are pinned (no :latest)
# in docker-compose.monitoring.yml. Ports are only published on the host
# in dev (docker-compose.dev.yml); in prod they stay on agentic-net.
# ----------------------------------------------------------------------
PROMETHEUS_PORT=9090
CADVISOR_PORT=8080
GRAFANA_PORT=3001
ALERTMANAGER_PORT=9093
# OBLIGATORIA cuando se apila docker-compose.monitoring.yml (prod-10 /
# secrets-6). Grafana con `admin/changeme-dev-only` publicado en este repo es un
# panel con acceso a todas las métricas del stack.
GRAFANA_ADMIN_PASSWORD=changeme-grafana-dev-only

# ----------------------------------------------------------------------
# searxng (ADR 0067) — buscador del córtex. `SEARXNG_SECRET` es la clave
# con la que firma sus formularios/cookies; OBLIGATORIA (prod-10).
# ----------------------------------------------------------------------
SEARXNG_SECRET=changeme-searxng-dev-only

# ----------------------------------------------------------------------
# Perfiles de aislamiento de los sandboxes (task_wf_55, ADR 0012 + 0040).
#
# El worker PINA estos perfiles sobre los contenedores no confiables que
# lanza (agent-runtime, test-runtime). El stack de dev los trae ya puestos
# con un default seguro; estas variables son la vía de escape.
#
# WORKERS_SECCOMP_PROFILE_PATH — ruta EN EL CONTENEDOR del worker al JSON
#   endurecido (viene del bind ./seccomp). Vacío = perfil por defecto de
#   Docker. Ponlo vacío si un toolchain choca con el allowlist estricto;
#   es preferible saber que se ha relajado a descubrirlo por un run que
#   falla sin explicación.
#
# WORKERS_APPARMOR_PROFILE — NOMBRE del perfil AppArmor cargado EN EL HOST.
#   Vacío por defecto: pinar un perfil que el host no tiene cargado hace
#   fallar la creación del contenedor, y Docker Desktop sobre WSL2 no trae
#   AppArmor. En un host Linux, cárgalo primero:
#       sudo apparmor_parser -r -W docker/apparmor/agent-runtime.profile
#   y luego pon WORKERS_APPARMOR_PROFILE=agent-runtime.
# ----------------------------------------------------------------------
# WORKERS_SECCOMP_PROFILE_PATH=/etc/agentic/seccomp/agent-runtime.json
# WORKERS_APPARMOR_PROFILE=agent-runtime
