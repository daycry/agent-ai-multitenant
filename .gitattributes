# Force LF line endings in the index across platforms.
# Without this, Windows clones with core.autocrlf=true store CRLF in the
# index and fight with hooks like mixed-line-ending (--fix=lf).

# Default: all text files normalized to LF.
* text=auto eol=lf

# Source code — explicit LF.
*.py     text eol=lf
*.ts     text eol=lf
*.tsx    text eol=lf
*.js     text eol=lf
*.jsx    text eol=lf
*.json   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.toml   text eol=lf
*.md     text eol=lf
*.sh     text eol=lf
*.sql    text eol=lf
*.html   text eol=lf
*.css    text eol=lf
Dockerfile* text eol=lf
.gitignore  text eol=lf
.gitattributes text eol=lf

# Windows-only scripts keep CRLF.
*.ps1  text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf

# Binary blobs — never touch.
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.svg    binary
*.pdf    binary
*.docx   binary
*.xlsx   binary
*.pptx   binary
*.zip    binary
*.tar.gz binary
*.woff   binary
*.woff2  binary
